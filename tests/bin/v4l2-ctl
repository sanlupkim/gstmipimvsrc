#!/bin/bash
# Atrapa: generuje klatki w formacie, ktory "ma" kamera, z gamma ZYWA tylko dla RAW8.
for a in "$@"; do case "$a" in --stream-to=*) OUT="${a#*=}";; esac; done
S="$(dirname "$0")/../state"
python3 - "$OUT" "$(awk '$1=="pixelformat"{print $2}' $S)" \
            "$(awk '$1=="gamma"{print $2}' $S)" "$(awk '$1=="gammaenable"{print $2}' $S)" \
            "$(awk '$1=="metime"{print $2}' $S)" <<'PY'
import sys
import numpy as np
out, fmt, g, en, exp = sys.argv[1], int(sys.argv[2]), float(sys.argv[3]), int(sys.argv[4]), int(sys.argv[5])
W, H, N = 240, 206, 3
rng = np.random.default_rng(3)
x = np.clip(np.linspace(0.01, 0.95, W)[None, :]*np.ones((H, 1)), 0, 1)
x[H//2:] *= 0.3
x = np.clip(x*(exp/300.0) + rng.normal(0, 0.002, x.shape), 1e-6, 1)
# gamma dziala TYLKO przy redukcji do 8 bitow - to odtwarza sekcje 17 raportu
live = (en == 1 and fmt == 0)
v12 = np.clip(4095.0*(x**g if live else x), 0, 4095).astype(np.uint16)
if fmt == 0:
    buf = np.tile((v12 >> 4).astype(np.uint8), (N, 1))
elif fmt == 1:
    v = (v12 >> 2).reshape(H, -1, 4)
    b = np.zeros((H, v.shape[1], 5), np.uint8)
    for i in range(4):
        b[:, :, i] = (v[:, :, i] >> 2).astype(np.uint8)
        b[:, :, 4] |= ((v[:, :, i] & 3) << (6 - 2*i)).astype(np.uint8)
    buf = np.tile(b.reshape(H, -1), (N, 1))
else:
    v = v12.reshape(H, -1, 2)
    b = np.zeros((H, v.shape[1], 3), np.uint8)
    b[:, :, 0] = (v[:, :, 0] >> 4).astype(np.uint8)
    b[:, :, 1] = (v[:, :, 1] >> 4).astype(np.uint8)
    b[:, :, 2] = (((v[:, :, 0] & 15) << 4) | (v[:, :, 1] & 15)).astype(np.uint8)
    buf = np.tile(b.reshape(H, -1), (N, 1))
buf.tofile(out)
PY
